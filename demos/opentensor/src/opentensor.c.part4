{
    int scene = (int)(t / 12.0f);
    float local = t - scene * 12.0f;
    if (scene > 4) { scene = 4; local = t - 48.0f; }

    glClearColor(0.008f, 0.012f, 0.028f, 1.0f);
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
    ot_set_perspective(d);

    switch (scene) {
    case 0: ot_scene_intro(d, local); break;
    case 1: ot_scene_field(d, local); break;
    case 2: ot_scene_boing(d, local); break;
    case 3: ot_scene_tensor(d, local); break;
    default: ot_scene_final(d, local); break;
    }
    if (d->overlay)
        ot_draw_stats(d);
}

static int ot_input(struct Demo *d)
{
    struct IntuiMessage *m;
    int quit = 0;
    if (SetSignal(0, SIGBREAKF_CTRL_C) & SIGBREAKF_CTRL_C)
        quit = 1;
    while ((m = (struct IntuiMessage *)GetMsg(d->window->UserPort))) {
        ULONG cls = m->Class;
        UWORD code = m->Code;
        if (cls == IDCMP_CLOSEWINDOW || cls == IDCMP_MOUSEBUTTONS)
            quit = 1;
        else if (cls == IDCMP_REFRESHWINDOW) {
            BeginRefresh(d->window);
            EndRefresh(d->window, TRUE);
        }
        else if (cls == IDCMP_RAWKEY && !(code & 0x80)) {
            switch (code) {
            case 0x45: quit = 1; break;                /* Esc */
            case 0x40:                                /* Space */
                d->paused = !d->paused;
                if (d->paused) d->pause_started = ot_now();
                else d->pause_total += ot_now() - d->pause_started;
                break;
            case 0x50: d->overlay = !d->overlay; break; /* F1 */
            default: break;
            }
        }
        ReplyMsg((struct Message *)m);
    }
    return quit;
}

static int ot_open_display(struct Demo *d)
{
    ULONG mode = (ULONG)INVALID_ID;
    ULONG open_depth = d->depth > 16 ? 24 : 16;

    CyberGfxBase = OpenLibrary("cybergraphics.library", 40);
    if (!CyberGfxBase) {
        printf("OpenTensor: cybergraphics.library 40 is required\n");
        return 0;
    }

    if (d->windowed) {
        d->window = OpenWindowTags(NULL,
            WA_Title, (ULONG)"OpenTensor: First Light",
            WA_InnerWidth, d->width, WA_InnerHeight, d->height,
            WA_DragBar, TRUE, WA_DepthGadget, TRUE, WA_CloseGadget, TRUE,
            WA_Activate, TRUE, WA_SizeGadget, FALSE, WA_SimpleRefresh, TRUE,
            WA_IDCMP, IDCMP_CLOSEWINDOW | IDCMP_RAWKEY | IDCMP_MOUSEBUTTONS | IDCMP_REFRESHWINDOW,
            TAG_DONE);
        if (!d->window) return 0;
        d->target.rp = d->window->RPort;
        d->target.bitmap = NULL;
        d->target.left = d->window->BorderLeft;
        d->target.top = d->window->BorderTop;
        return 1;
    }

    mode = BestCModeIDTags(CYBRBIDTG_NominalWidth, d->width,
                           CYBRBIDTG_NominalHeight, d->height,
                           CYBRBIDTG_Depth, d->depth, TAG_DONE);
    if (mode == (ULONG)INVALID_ID) {
        d->width = 640; d->height = 360; d->depth = 32; open_depth = 24;
        mode = BestCModeIDTags(CYBRBIDTG_NominalWidth, d->width,
                               CYBRBIDTG_NominalHeight, d->height,
                               CYBRBIDTG_Depth, d->depth, TAG_DONE);
    }
    if (mode == (ULONG)INVALID_ID) {
        printf("OpenTensor: no suitable OpenRTG mode\n");
        return 0;
    }

    d->screen = OpenScreenTags(NULL,
        SA_DisplayID, mode, SA_Width, d->width, SA_Height, d->height,
        SA_Depth, open_depth, SA_Quiet, TRUE, SA_ShowTitle, FALSE,
        SA_Type, CUSTOMSCREEN, SA_Exclusive, TRUE,
        SA_Title, (ULONG)"OpenTensor: First Light", TAG_DONE);
    if (!d->screen) {
        printf("OpenTensor: could not open %dx%dx%d OpenRTG screen\n",
               d->width, d->height, d->depth);
        return 0;
    }
    d->window = OpenWindowTags(NULL,
        WA_CustomScreen, (ULONG)d->screen, WA_Left, 0, WA_Top, 0,
        WA_Width, d->width, WA_Height, d->height,
        WA_Backdrop, TRUE, WA_Borderless, TRUE, WA_Activate, TRUE,
        WA_RMBTrap, TRUE, WA_SimpleRefresh, TRUE, WA_NoCareRefresh, TRUE,
        WA_IDCMP, IDCMP_RAWKEY | IDCMP_MOUSEBUTTONS | IDCMP_CLOSEWINDOW,
        TAG_DONE);
    if (!d->window) return 0;
    d->target.rp = d->window->RPort;
    d->target.bitmap = d->screen->RastPort.BitMap;
    d->target.left = 0;
    d->target.top = 0;
    return 1;
}

static int ot_open_gl(struct Demo *d)
{
    struct gla_config cfg = { GLA_COMPAT, 0, 0, 1, 24, 0, 0 };
    gla_os3_present_init(&d->present, &d->target);
    if (!d->cpu) {
        struct gla_virgl_transport t;
        if (gla_os3_virgl_transport(&t))
            d->display = gla_display_create_virgl(&t);
    }
    if (!d->display)
        d->display = gla_display_create();
    d->context = d->display ? gla_context_create(d->display, &cfg, NULL) : NULL;
    d->buffer = d->context ? gla_buffer_create(d->display, &cfg,
                                                d->width, d->height, &d->present) : NULL;
    if (!d->buffer || !gla_make_current(d->context, d->buffer))
        return 0;

    printf("OpenTensor: renderer %s, driver %s, OpenGL %s\n",
           (const char *)glGetString(GL_RENDERER), gla_display_driver(d->display),
           (const char *)glGetString(GL_VERSION));
    glEnable(GL_DEPTH_TEST);
    glDepthFunc(GL_LEQUAL);
    glShadeModel(GL_SMOOTH);
    glDisable(GL_CULL_FACE);
    glEnable(GL_POINT_SMOOTH);
    glHint(GL_POINT_SMOOTH_HINT, GL_NICEST);
    return 1;
}

static void ot_close(struct Demo *d)
{
    ot_audio_close(&d->audio);
    if (d->context) gla_make_current(NULL, NULL);
    if (d->buffer) gla_buffer_destroy(d->buffer);
    if (d->context) gla_context_destroy(d->context);
    if (d->display) gla_display_destroy(d->display);
    ot_mesh_free(&d->tunnel);
    ot_mesh_free(&d->stars);
    ot_mesh_free(&d->ball);
    ot_mesh_free(&d->ground);
    if (d->window) CloseWindow(d->window);
    if (d->screen) CloseScreen(d->screen);
    if (CyberGfxBase) CloseLibrary(CyberGfxBase);
    CyberGfxBase = NULL;
}

static void ot_usage(void)
{
    printf("OpenTensor [CPU] [WINDOW] [W n] [H n] [DEPTH 16|32] [SECONDS n] [NOAUDIO] [NOVSYNC]\n");
    printf("  Esc or mouse exits; Space pauses; F1 toggles the diagnostic overlay.\n");
}

int main(int argc, char **argv)
{
    struct Demo d;
    int i, quit = 0;
    memset(&d, 0, sizeof(d));
    d.width = 960;
    d.height = 540;
    d.depth = 32;
    d.vsync = 1;
    d.overlay = 1;

    for (i = 1; i < argc; i++) {
        if (!strcasecmp(argv[i], "CPU")) d.cpu = 1;
        else if (!strcasecmp(argv[i], "WINDOW")) d.windowed = 1;
        else if (!strcasecmp(argv[i], "NOAUDIO")) d.noaudio = 1;
        else if (!strcasecmp(argv[i], "NOVSYNC")) d.vsync = 0;
        else if (!strcasecmp(argv[i], "W") && i + 1 < argc) d.width = atoi(argv[++i]);
        else if (!strcasecmp(argv[i], "H") && i + 1 < argc) d.height = atoi(argv[++i]);
        else if (!strcasecmp(argv[i], "DEPTH") && i + 1 < argc) d.depth = atoi(argv[++i]);
        else if (!strcasecmp(argv[i], "SECONDS") && i + 1 < argc) d.seconds = atoi(argv[++i]);
        else if (!strcasecmp(argv[i], "HELP") || !strcmp(argv[i], "?")) { ot_usage(); return 0; }
        else { printf("OpenTensor: unknown option %s\n", argv[i]); ot_usage(); return RETURN_WARN; }
    }
    d.width = ot_clampi(d.width, 320, 1920);
    d.height = ot_clampi(d.height, 200, 1080);
    d.depth = d.depth <= 16 ? 16 : 32;

    if (!ot_build_ground(&d.ground) || !ot_build_ball(&d.ball) ||
        !ot_build_stars(&d.stars) || !ot_build_tunnel(&d.tunnel)) {
        printf("OpenTensor: not enough memory for scene geometry\n");
        ot_close(&d);
        return RETURN_FAIL;
    }
    if (!ot_open_display(&d)) {
        ot_close(&d);
        return RETURN_FAIL;
    }
    if (!ot_open_gl(&d)) {
        printf("OpenTensor: Mesa / GLA could not start\n");
        ot_close(&d);
        return RETURN_FAIL;
    }
    if (!d.noaudio && !ot_audio_open(&d.audio)) {
        printf("OpenTensor: AHI could not start; continuing silently\n");
        memset(&d.audio, 0, sizeof(d.audio));
    }

    printf("OpenTensor: %dx%dx%d %s, AHI %s\n",
           d.width, d.height, d.depth,
           d.windowed ? "windowed compatibility" : "full-screen OpenRTG direct",
           d.audio.ready ? "44.1 kHz stereo" : "off");
    d.start_time = d.fps_mark = ot_now();

    while (!quit) {
        double now = ot_now();
        double elapsed = now - d.start_time - d.pause_total;
        float sequence;
        ot_audio_pump(&d.audio);
        quit = ot_input(&d);
        if (!d.paused) {
            sequence = (float)elapsed;
            while (sequence >= OT_SEQUENCE_SECONDS) sequence -= OT_SEQUENCE_SECONDS;
            ot_render(&d, sequence);
            gla_swap(d.context, d.buffer);
            d.fps_frames++;
            if (d.vsync) WaitTOF();
        } else {
            WaitTOF();
        }
        if (now - d.fps_mark >= 1.0) {
            d.fps = (float)((double)d.fps_frames / (now - d.fps_mark));
            d.fps_frames = 0;
            d.fps_mark = now;
        }
        if (d.seconds > 0 && elapsed >= d.seconds)
            quit = 1;
    }

    printf("OpenTensor: %.1f fps, %lu AHI underruns\n",
           d.fps, (unsigned long)d.audio.underruns);
    ot_close(&d);
    return RETURN_OK;
}
