struct Library *CyberGfxBase = NULL;

#define OT_PI 3.14159265358979323846f
#define OT_TAU 6.28318530717958647692f
#define OT_AUDIO_RATE 44100UL
#define OT_AUDIO_FRAMES 8192UL
#define OT_AUDIO_WORDS (OT_AUDIO_FRAMES * 2UL)
#define OT_SEQUENCE_SECONDS 164.0f
#define OT_SCENE_COUNT 11
#define OT_JUMP_NONE (-9999.0f)
#define OT_MAX(a,b) ((a) > (b) ? (a) : (b))
#define OT_MIN(a,b) ((a) < (b) ? (a) : (b))

struct Mesh {
    GLfloat *v;
    GLfloat *c;
    uint16_t *radial;
    GLsizei count;
    GLenum mode;
};

#include "opentensor_score.h"

struct AudioState {
    struct MsgPort *port;
    struct AHIRequest *req[2];
    WORD *pcm[2];
    int inflight[2];
    int ready;
    ULONG underruns;
    uint64_t sample_cursor;
    struct OtScore score;

};

struct Demo {
    int width;
    int height;
    int full_width;
    int full_height;
    int depth;
    int windowed;
    int cpu;
    int noaudio;
    int vsync;
    int overlay;
    int paused;
    int seconds;
    int current_scene;
    int breakout_active;
    int breakout_move_tick;
    float start_offset;
    float jump_request;
    struct Screen *screen;
    struct Window *window;
    struct Window *breakout_window;
    struct gla_display *display;
    struct gla_context *context;
    struct gla_buffer *buffer;
    struct gla_buffer *main_buffer;
    struct gla_buffer *breakout_buffer;
    struct gla_present present;
    struct gla_os3_target target;
    struct Mesh ground;
    struct Mesh ball;
    struct Mesh stars;
    struct Mesh tunnel;
    struct AudioState audio;
    char driver_name[16];
    double start_time;
    double pause_started;
    double pause_total;
    double fps_mark;
    ULONG fps_frames;
    float fps;
};

static float ot_absf(float x) { return x < 0.0f ? -x : x; }

/* Small, predictable trigonometry. It keeps this demo independent of any
 * target libm corner cases and uses only operations the 68040 has. */
static float ot_wrap(float x)
{
    while (x > OT_PI) x -= OT_TAU;
    while (x < -OT_PI) x += OT_TAU;
    return x;
}

static float ot_sin(float x)
{
    float x2, term, sum;
    x = ot_wrap(x);
    x2 = x * x;
    term = x;
    sum = term;
    term *= -x2 / 6.0f; sum += term;
    term *= -x2 / 20.0f; sum += term;
    term *= -x2 / 42.0f; sum += term;
    term *= -x2 / 72.0f; sum += term;
    term *= -x2 / 110.0f; sum += term;
    return sum;
}

static float ot_cos(float x) { return ot_sin(x + OT_PI * 0.5f); }

static double ot_now(void)
{
    struct DateStamp ds;
    DateStamp(&ds);
    return (double)ds.ds_Days * 86400.0 +
           (double)ds.ds_Minute * 60.0 +
           (double)ds.ds_Tick / (double)TICKS_PER_SECOND;
}

static int ot_clampi(int v, int lo, int hi)
{
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

static void ot_audio_fill(struct AudioState *a, WORD *dst)
{
    ot_score_render(&a->score, (int16_t *)dst, OT_AUDIO_FRAMES);
    a->sample_cursor += OT_AUDIO_FRAMES;
}
