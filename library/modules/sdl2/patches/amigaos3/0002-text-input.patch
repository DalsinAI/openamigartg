+/* Translate one copied Intuition raw-key record through the active Amiga
+ * keymap. dead_key is the packed ie_dead value copied from IAddress before
+ * ReplyMsg(), not the Intuition-owned pointer itself. */
+static int OS3_MapRawText(UWORD code, UWORD qualifier, APTR dead_key,
+                          unsigned char *buffer, int capacity)
+{
+    struct InputEvent event;
+    LONG result;
+
+    if (!KeymapBase || !buffer || capacity < 2 ||
+        (code & AMIGA_KEY_UP) || !SDL_IsTextInputActive()) {
+        return 0;
+    }
+
+    /* Shortcuts remain key events only. Alt/Right-Alt is deliberately left
+     * to the active keymap so national printable characters still work. */
+    if (qualifier & (IEQUALIFIER_CONTROL |
+                     IEQUALIFIER_LCOMMAND |
+                     IEQUALIFIER_RCOMMAND)) {
+        return 0;
+    }
+
+    SDL_zero(event);
+    event.ie_Class = IECLASS_RAWKEY;
+    event.ie_SubClass = 0;
+    event.ie_Code = code & ~AMIGA_KEY_UP;
+    event.ie_Qualifier = qualifier;
+    event.ie_EventAddress = dead_key;
+
+    result = MapRawKey(&event, (STRPTR)buffer, (LONG)capacity, NULL);
+    if (result <= 0 || result > capacity) {
+        return 0;
+    }
+    return (int)result;
+}
