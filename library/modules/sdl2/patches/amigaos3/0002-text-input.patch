+/* MapRawKey returns Amiga ANSI bytes. SDL_TEXTINPUT requires UTF-8. */
+static int OS3_AmigaTextToUTF8(const unsigned char *src, int src_len,
+                               char *dst, int dst_len)
+{
+    int i;
+    int out = 0;
+
+    if (!src || src_len <= 0 || !dst || dst_len <= 1) {
+        return 0;
+    }
+
+    for (i = 0; i < src_len; i++) {
+        unsigned int c = src[i];
+
+        /* Escape-prefixed key sequences, C0 controls, DEL and C1
+         * controls are keyboard commands, not text. */
+        if (c < 0x20 || (c >= 0x7f && c < 0xa0)) {
+            return 0;
+        }
+
+        if (c < 0x80) {
+            if (out + 1 >= dst_len) {
+                return 0;
+            }
+            dst[out++] = (char)c;
+        } else {
+            if (out + 2 >= dst_len) {
+                return 0;
+            }
+            dst[out++] = (char)(0xc0 | (c >> 6));
+            dst[out++] = (char)(0x80 | (c & 0x3f));
+        }
+    }
+
+    dst[out] = '\0';
+    return out;
+}
