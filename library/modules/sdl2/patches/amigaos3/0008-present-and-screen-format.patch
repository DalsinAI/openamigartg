+static int OS3_GPU_Present(SDL_Window *window, OS3_WindowData *data, SDL_Surface *surface,
+                           const SDL_Rect *rects, int numrects)
+{
+    OS3_GPUPresent *gp;
+    SDL_OS3_GPUPresent p;
+    struct OGPUBatch b;
+    ULONG fence = 0;
+
+    (void)data;
+    SDL_zero(p);
+    gp = OS3_GPU_State(window);
+    if (!gp || !gp->usable) {
+        return 0;
+    }
+    ogpu_batch_init(&b, gp->stream, OS3_GPU_WORDS);
+    if (SDL_OS3_GPU_PresentAppend(window, surface, &b, 0, 1, rects, numrects, &p) != 1) {
+        return 0;
+    }
+    if (!b.overflow && OGPU_Submit(gp->stream, (ULONG)b.words, &fence) == OGPU_OK) {
+        OGPU_Wait(fence); /* done before the bitmap and layer are let go */
+        SDL_OS3_GPU_PresentEnd(&p);
+        return 1;
+    }
+    /* not sent: the CPU draws the whole window */
+    UnLockBitMap(p.bmlock);
+    UnlockLayer(p.layer);
+    return 0;
