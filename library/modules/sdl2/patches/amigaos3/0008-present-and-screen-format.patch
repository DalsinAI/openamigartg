+/* The window surface's format (Open, 22 Oct 2026): RGB565 or RGB555 on a
+ * 16-bit screen of that byte order, pens on a screen of our own with 8 bits
+ * (its palette is the surface's), ARGB8888 anywhere else. SDL_OS3_SCREENFORMAT=0
+ * keeps ARGB8888 everywhere, for programs that write the surface's pixels
+ * without looking at its format. */
+static Uint32 OS3_SurfaceFormat(OS3_WindowData *data)
+{
+    struct BitMap *bm;
+    ULONG iscgx, pixfmt;
+
+    if (!data || !data->window || !SDL_GetHintBoolean("SDL_OS3_SCREENFORMAT", SDL_TRUE)) {
+        return SDL_PIXELFORMAT_ARGB8888;
+    }
+    bm = data->window->RPort->BitMap;
+    iscgx = GetCyberMapAttr(bm, CYBRMATTR_ISCYBERGFX);
+    if (!iscgx) {
+        return SDL_PIXELFORMAT_ARGB8888;
+    }
+    pixfmt = GetCyberMapAttr(bm, CYBRMATTR_PIXFMT);
+    switch (pixfmt) {
+    case PIXFMT_RGB16:
+        return SDL_PIXELFORMAT_RGB565;
+    case PIXFMT_RGB15:
+        return SDL_PIXELFORMAT_RGB555;
+    case PIXFMT_LUT8:
+        if (data->screen) {
+            return SDL_PIXELFORMAT_INDEX8;
+        }
+        break;
+    default:
+        break;
+    }
+    return SDL_PIXELFORMAT_ARGB8888;
+}
+
+/* The window surface's pixels in Fast RAM (any RAM on a machine without),
+ * the first row on 16 bytes and, when round is set, each row a multiple of
+ * 16 bytes long, so a row starts on a 68040 cache line. SDL's own
+ * allocation when that fails. */
+static SDL_Surface *OS3_AllocSurface(SDL_Window *window, int w, int h, Uint32 fmt, SDL_bool round)
+{
+    SDL_Surface *surface;
+    int bpp = SDL_BYTESPERPIXEL(fmt);
+    int pitch = w * bpp;
+    UBYTE *mem;
+
+    if (round) {
+        pitch = (pitch + 15) & ~15;
+    }
+    mem = (UBYTE *)AllocVec((ULONG)pitch * h + 15, MEMF_FAST | MEMF_CLEAR);
+    if (!mem) {
+        mem = (UBYTE *)AllocVec((ULONG)pitch * h + 15, MEMF_ANY | MEMF_CLEAR);
+    }
+    if (mem) {
+        void *pixels = (void *)(((ULONG)mem + 15) & ~15UL);
+        surface = SDL_CreateRGBSurfaceWithFormatFrom(pixels, w, h, SDL_BITSPERPIXEL(fmt), pitch, fmt);
+        if (surface) {
+            SDL_SetWindowData(window, OS3_PIXELS_KEY, mem);
+            return surface;
+        }
+        FreeVec(mem);
+    }
+    return SDL_CreateRGBSurfaceWithFormat(0, w, h, SDL_BITSPERPIXEL(fmt), fmt);
+}
