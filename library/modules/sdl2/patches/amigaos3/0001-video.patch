+/* Open (2026): a window is shown by OpenGPU, which copies the frame into
+   video RAM (on the Cradle, the PC does it), through each visible part of
+   the window's layer. A window with a covered part, a screen OpenGPU has no
+   format for, or no opengpu.library: WritePixelArray, as before. */
+#define OS3_GPU_KEY "OS3_GPU"
+#define OS3_GPU_WORDS 2048
+
+typedef struct OS3_GPUPresent {
+    SDL_bool usable;
+    Uint32 stream[OS3_GPU_WORDS];
+} OS3_GPUPresent;
+
+static int OS3_GPU_Present(SDL_Window *window, OS3_WindowData *data, SDL_Surface *surface,
+                           const SDL_Rect *rects, int numrects)
+{
+    OS3_GPUPresent *gp = (OS3_GPUPresent *)SDL_GetWindowData(window, OS3_GPU_KEY);
+    struct Window *win = data->window;
+    struct Layer *layer = win->RPort->Layer;
+    struct BitMap *bm = win->RPort->BitMap;
+    struct ClipRect *cr;
+    struct OGPUBatch b;
+    ULONG base = 0, bpr = 0, pixfmt = 0, bw, bh, iscgx, fence = 0;
+    APTR lock;
+    int fmt, i, ok = 0;
+
+    if (!gp) {
+        gp = (OS3_GPUPresent *)SDL_calloc(1, sizeof(*gp));
+        if (!gp) {
+            return 0;
+        }
+        gp->usable = SDL_OS3_GPU_Open();
+        SDL_SetWindowData(window, OS3_GPU_KEY, gp);
+    }
+    if (!gp->usable || !layer) {
+        return 0;
+    }
+    /* Each value asked on its own: bebbo gcc's inlines must not nest. */
+    iscgx = GetCyberMapAttr(bm, CYBRMATTR_ISCYBERGFX);
+    if (!iscgx) {
+        return 0;
+    }
+    bw = GetCyberMapAttr(bm, CYBRMATTR_WIDTH);
+    bh = GetCyberMapAttr(bm, CYBRMATTR_HEIGHT);
+
+    LockLayer(0, layer);
+    for (cr = layer->ClipRect; cr; cr = cr->Next) {
+        if (cr->obscured) {
+            UnlockLayer(layer);
+            return 0;
+        }
+    }
+    lock = LockBitMapTags(bm, LBMI_BASEADDRESS, (ULONG)&base, LBMI_BYTESPERROW, (ULONG)&bpr,
+                          LBMI_PIXFMT, (ULONG)&pixfmt, TAG_DONE);
+    fmt = SDL_OS3_GPU_FormatOfPixfmt(pixfmt);
+    if (lock && base && fmt) {
+        ogpu_batch_init(&b, gp->stream, OS3_GPU_WORDS);
+        ogpu_surface(&b, 0, base, bpr, (int)bw, (int)bh, fmt);
+        ogpu_target(&b, 0);
+        ogpu_surface(&b, 1, (unsigned long)surface->pixels, (unsigned long)surface->pitch,
+                     surface->w, surface->h, OGPU_FMT_ARGB32);
+        for (cr = layer->ClipRect; cr; cr = cr->Next) {
+            ogpu_clip(&b, cr->bounds.MinX, cr->bounds.MinY,
+                      cr->bounds.MaxX - cr->bounds.MinX + 1, cr->bounds.MaxY - cr->bounds.MinY + 1);
+            for (i = 0; i < numrects; i++) {
+                const SDL_Rect *r = &rects[i];
+                int dx = layer->bounds.MinX + r->x, dy = layer->bounds.MinY + r->y;
+                if (r->w <= 0 || r->h <= 0) {
+                    continue;
+                }
+                if (fmt == OGPU_FMT_ARGB32) {
+                    ogpu_copy(&b, 1, r->x, r->y, dx, dy, r->w, r->h);
+                } else {
+                    ogpu_composite(&b, 1, r->x, r->y, r->w, r->h, dx, dy, r->w, r->h, 255, 0);
+                }
+            }
+        }
+        if (!b.overflow && OGPU_Submit(gp->stream, (ULONG)b.words, &fence) == OGPU_OK) {
+            OGPU_Wait(fence); /* done before the bitmap and layer are let go */
+            ok = 1;
+        }
+    }
+    if (lock) {
+        UnLockBitMap(lock);
+    }
+    UnlockLayer(layer);
+    return ok;
+}
