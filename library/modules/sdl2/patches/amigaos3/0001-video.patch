+/* The c2p is assembled for one bitplane size (BPLSIZE in the Makefile, a
+ * 320x256 screen) and eight planes one after another. Any other screen took
+ * the same plane offsets: a 640-wide screen had every plane written into its
+ * first 40 KB (a near-black picture), a smaller one was written past its
+ * bitmap. So it is used only on a bitmap laid out as it expects, and anything
+ * else goes through graphics' WriteChunkyPixels (6 Oct 2026). */
+#define OS3_C2P_BPLSIZE 10240UL
+
+static int c2p_width = 0, c2p_height = 0;
+
 void OS3_AGA_C2PInit(int width, int height)
 {
 #ifndef WARPUP
     c2p1x1_8_c5_gen_init(width, height, 0);
+    c2p_width = width;
+    c2p_height = height;
 #endif
 }
 
+static int OS3_AGA_C2PFits(const struct BitMap *bm, int width, int height)
+{
+    int p;
+
+    if (bm->Depth != 8 || (width & 31) || height > bm->Rows ||
+        (ULONG)bm->BytesPerRow * 8 != (ULONG)width ||
+        (ULONG)bm->BytesPerRow * bm->Rows != OS3_C2P_BPLSIZE) {
+        return 0;
+    }
+    for (p = 1; p < 8; p++) {
+        if ((UBYTE *)bm->Planes[p] != (UBYTE *)bm->Planes[0] + p * OS3_C2P_BPLSIZE) {
+            return 0;
+        }
+    }
+    return 1;
+}
+
 void OS3_AGA_C2P(const void *chunky, struct Screen *screen,
                  int width, int height)
 {
     struct BitMap *bm;
 
-    (void)width;
-    (void)height;
-
     if (!screen) {
         return;
     }
@@ -89,10 +115,17 @@
     }
 
 #ifndef WARPUP
-    /* Kalms c2p expects contiguous bitplanes with BPLSIZE spacing.
-     * Standard AGA screen bitmaps from OpenScreen have this layout. */
-    c2p1x1_8_c5_gen((void *)chunky, (void *)bm->Planes[0]);
+    if (OS3_AGA_C2PFits(bm, width, height)) {
+        if (width != c2p_width || height != c2p_height) {
+            OS3_AGA_C2PInit(width, height);
+        }
+        c2p1x1_8_c5_gen((void *)chunky, (void *)bm->Planes[0]);
+        return;
+    }
 #endif
+    /* An INDEX8 surface's pitch: SDL rounds each row up to 4 bytes. */
+    WriteChunkyPixels(&screen->RastPort, 0, 0, width - 1, height - 1,
+                      (UBYTE *)chunky, (width + 3) & ~3);
