+/* Remove this task's entry from the waiter list. Returns 1 if it was
+   still there (nobody posted to it), 0 if a post already took it off.
+   Call with sem->lock held. */
+static int OS3_SemRemoveWaiter(SDL_sem *sem, struct Task *me, BYTE sig)
+{
+    int i;
+    for (i = 0; i < sem->num_waiters; i++) {
+        if (sem->waiters[i].task == me && sem->waiters[i].signal_bit == sig) {
+            sem->num_waiters--;
+            if (i < sem->num_waiters) {
+                SDL_memmove(&sem->waiters[i], &sem->waiters[i + 1],
+                            (sem->num_waiters - i) * sizeof(sem->waiters[0]));
+            }
+            return 1;
+        }
+    }
+    return 0;
+}
+
 int SDL_SemWaitTimeout(SDL_sem *sem, Uint32 timeout)
 {
     struct Task *me;
@@ -102,27 +122,10 @@
         return SDL_MUTEX_TIMEDOUT;
