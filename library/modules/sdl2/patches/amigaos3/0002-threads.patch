-    if (timeout != SDL_MUTEX_MAXWAIT) {
-        Uint32 start = SDL_GetTicks();
-        ReleaseSemaphore(&sem->lock);
-
-        while ((SDL_GetTicks() - start) < timeout) {
-            SDL_Delay(1);
-            ObtainSemaphore(&sem->lock);
-            if (sem->count > 0) {
-                sem->count--;
-                ReleaseSemaphore(&sem->lock);
-                return 0;
-            }
-            ReleaseSemaphore(&sem->lock);
-        }
-        return SDL_MUTEX_TIMEDOUT;
-    }
-
-    /* Infinite wait: block on signal */
+    /* Open (2026): finite and infinite waits both queue as a waiter and
+       sleep on a signal; a finite wait also sleeps on a timer.device
+       request. Upstream polled finite waits with SDL_Delay(1), which was
+       20 ms a turn, so SDL_AddTimer callbacks ran late. */
     me = FindTask(NULL);
     sig = AllocSignal(-1);
     if (sig == -1) {
@@ -142,7 +145,21 @@
     sem->num_waiters++;
     ReleaseSemaphore(&sem->lock);
 
