diff --git a/src/video/SDL_video.c b/src/video/SDL_video.c
index b519602..49d2d22 100644
--- a/src/video/SDL_video.c
+++ b/src/video/SDL_video.c
@@ -2765,7 +2765,25 @@ static SDL_Surface *SDL_CreateWindowFramebuffer(SDL_Window *window)
         return NULL;
     }
 
+#ifdef SDL_VIDEO_DRIVER_AMIGAOS3
+    {
+        /* An 8-bit window surface (AmigaOS 3.x on AGA) would start with
+         * SDL_AllocPalette's all-white palette, so every SDL_MapRGB and every
+         * blit landed on white. Give it the 3-3-2 palette SDL dithers to
+         * (SDL_DitherColors); a program's own SDL_SetPaletteColors replaces it,
+         * and the driver loads whatever palette the surface has each frame.
+         * (Open, 6 Oct 2026) */
+        SDL_Surface *surface = SDL_CreateRGBSurfaceFrom(pixels, w, h, bpp, pitch, Rmask, Gmask, Bmask, Amask);
+        if (surface && surface->format->palette) {
+            SDL_Color colors[256];
+            SDL_DitherColors(colors, 8);
+            SDL_SetPaletteColors(surface->format->palette, colors, 0, 256);
+        }
+        return surface;
+    }
+#else
     return SDL_CreateRGBSurfaceFrom(pixels, w, h, bpp, pitch, Rmask, Gmask, Bmask, Amask);
+#endif
 }
 
