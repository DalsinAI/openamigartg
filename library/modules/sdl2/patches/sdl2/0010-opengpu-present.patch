+#if OGPUR_YUVS
+/* A YUV texture that changed since it was last converted, copied plainly at
+   its size or smaller (Open, 22 Oct 2026): converted straight into the
+   target with YUV_SCALED, a pass over the destination's pixels only, where
+   converting into its ARGB32 surface first and copying that is a pass over
+   the whole picture and then one over the destination. Its surface stays
+   unconverted, so a later copy converts it then. */
+static SDL_bool OGPUR_DirectYUV(OGPUR_RenderData *data, SDL_Surface *s, const SDL_Rect *srcrect, const SDL_Rect *dstrect)
+{
+    OGPUR_YUV *y = (OGPUR_YUV *)s->userdata;
+
+    if (!y || !y->dirty || !data->can_yuv_scaled || dstrect->w <= 0 || dstrect->h <= 0 ||
+        (long)dstrect->w * dstrect->h > (long)srcrect->w * srcrect->h ||
+        srcrect->x < 0 || srcrect->y < 0 || srcrect->x + srcrect->w > y->w || srcrect->y + srcrect->h > y->h) {
+        return SDL_FALSE;
+    }
+    OGPUR_Reserve(data, 24, 0);
+    ogpu_yuv_scaled(&data->batch, (unsigned long)y->y, y->ypitch, (unsigned long)y->u, y->uvpitch,
+                    (unsigned long)y->v, y->v ? y->uvpitch : 0, y->w, y->h, y->ogpu_format,
+                    srcrect->x, srcrect->y, srcrect->w, srcrect->h,
+                    dstrect->x, dstrect->y, dstrect->w, dstrect->h);
+    return SDL_TRUE;
+}
+#endif
