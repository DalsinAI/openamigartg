diff --git a/src/atomic/SDL_spinlock.c b/src/atomic/SDL_spinlock.c
index bdfa082..2e459e0 100644
--- a/src/atomic/SDL_spinlock.c
+++ b/src/atomic/SDL_spinlock.c
@@ -44,6 +44,10 @@
 #include <kernel.h>
 #endif
 
+#if defined(__AMIGAOS3__)
+#include <proto/exec.h>
+#endif
+
 #if !defined(HAVE_GCC_ATOMICS) && defined(__MACOSX__)
 #include <libkern/OSAtomic.h>
 #endif
@@ -163,6 +167,19 @@ SDL_bool SDL_AtomicTryLock(SDL_SpinLock *lock)
         EIntr();
     }
     return res;
+#elif defined(__AMIGAOS3__)
+    /* AmigaOS 3.x has one CPU and Exec's task switching; a lock taken
+       inside Forbid() can't be raced by another task. CAS and TAS are not
+       used: their read-modify-write cycles fail on Chip RAM. (The idea is
+       libSDL2-amigaos3's, Zlib.) */
+    SDL_bool res = SDL_FALSE;
+    Forbid();
+    if (*lock == 0) {
+        *lock = 1;
+        res = SDL_TRUE;
+    }
+    Permit();
+    return res;
 #else
 #error Please implement for your platform.
     return SDL_FALSE;
