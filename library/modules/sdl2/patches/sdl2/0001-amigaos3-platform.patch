diff --git a/src/dynapi/SDL_dynapi.c b/src/dynapi/SDL_dynapi.c
index 04adfd2..c7d1d9e 100644
--- a/src/dynapi/SDL_dynapi.c
+++ b/src/dynapi/SDL_dynapi.c
@@ -408,6 +408,16 @@ static SDL_INLINE void *get_sdlapi_entry(const char *fname, const char *sym)
     return (void *)retval;
 }
 
+#elif defined(__AMIGAOS3__)
+/* Open (2026): SDL 2 lives inside one shared library, which hands its table
+   out through SDL_DYNAPI_entry; there is no other SDL to load over it. */
+static SDL_INLINE void *get_sdlapi_entry(const char *fname, const char *sym)
+{
+    (void)fname;
+    (void)sym;
+    return NULL;
+}
+
 #else
 #error Please define your platform.
 #endif
@@ -454,6 +464,8 @@ static void SDL_InitDynamicAPILocked(void)
     if (DosScanEnv(SDL_DYNAMIC_API_ENVVAR, &libname) != NO_ERROR) {
         libname = NULL;
     }
+#elif defined(__AMIGAOS3__)
+    char *libname = NULL;
 #else
     char *libname = getenv(SDL_DYNAMIC_API_ENVVAR);
 #endif
