diff --git a/include/SDL_platform.h b/include/SDL_platform.h
index 64ece4f..74116f6 100644
--- a/include/SDL_platform.h
+++ b/include/SDL_platform.h
@@ -28,6 +28,11 @@
 #ifndef SDL_platform_h_
 #define SDL_platform_h_
 
+/* AmigaOS 3.x on the 68k (Open): bebbo's gcc defines __AMIGA__. */
+#if defined(__AMIGA__) && !defined(__amigaos4__) && !defined(__MORPHOS__) && !defined(__AROS__)
+#undef __AMIGAOS3__
+#define __AMIGAOS3__ 1
+#endif
 #if defined(_AIX)
