+    case SDL_YUV_CONVERSION_JPEG: space = OGPU_YUV_JPEG; break;
+    case SDL_YUV_CONVERSION_BT709: space = OGPU_YUV_BT709; break;
+    default: space = OGPU_YUV_BT601; break;
