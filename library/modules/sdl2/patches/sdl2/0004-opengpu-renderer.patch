+/* SDL's single-buffer layout: the Y plane at `pitch`, then the chroma planes
+   at half that pitch (I420, YV12) or the interleaved plane at the even
+   pitch (NV12, NV21), as SDL_UpdateTexture hands them. */
+static void OGPUR_YUVUpdate(OGPUR_YUV *y, const SDL_Rect *rect, const void *pixels, int pitch)
+{
+    const Uint8 *src = (const Uint8 *)pixels;
+    const int cw = (rect->w + 1) / 2, ch = (rect->h + 1) / 2, cx = rect->x / 2, cy = rect->y / 2;
+
+    if (OGPUR_IsPacked(y->format)) {
+        OGPUR_CopyPlane(y->y + rect->y * y->ypitch + rect->x * 2, y->ypitch, src, pitch, cw * 4, rect->h);
+    } else if (y->v) {
+        const int spitch = (pitch + 1) / 2;
+        const Uint8 *s1 = src + (size_t)pitch * rect->h;
+        const Uint8 *s2 = s1 + (size_t)spitch * ch;
+        OGPUR_CopyPlane(y->y + rect->y * y->ypitch + rect->x, y->ypitch, src, pitch, rect->w, rect->h);
+        OGPUR_CopyPlane(y->u + cy * y->uvpitch + cx, y->uvpitch, s1, spitch, cw, ch);
+        OGPUR_CopyPlane(y->v + cy * y->uvpitch + cx, y->uvpitch, s2, spitch, cw, ch);
+    } else {
+        const int spitch = 2 * ((pitch + 1) / 2);
+        OGPUR_CopyPlane(y->y + rect->y * y->ypitch + rect->x, y->ypitch, src, pitch, rect->w, rect->h);
+        OGPUR_CopyPlane(y->u + cy * y->uvpitch + cx * 2, y->uvpitch, src + (size_t)pitch * rect->h, spitch, cw * 2, ch);
+    }
+    y->dirty = SDL_TRUE;
+}
