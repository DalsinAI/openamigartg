+static OGPUR_YUV *OGPUR_YUVCreate(Uint32 format, int w, int h)
+{
+    OGPUR_YUV *y = (OGPUR_YUV *)SDL_calloc(1, sizeof(*y));
+    unsigned long space;
+    size_t size;
+
+    if (!y) {
+        return NULL;
+    }
+    y->format = format;
+    y->w = (w + 1) & ~1;
+    y->h = (h + 1) & ~1;
+    if (OGPUR_IsPacked(format)) {
+        y->ypitch = y->w * 2;
+        size = (size_t)y->ypitch * y->h;
+    } else {
+        y->ypitch = y->w;
+        y->uvpitch = (format == SDL_PIXELFORMAT_NV12 || format == SDL_PIXELFORMAT_NV21) ? y->w : y->w / 2;
+        size = (size_t)y->w * y->h * 3 / 2;
+    }
+    y->planes = (Uint8 *)SDL_calloc(1, size);
+    if (!y->planes) {
+        SDL_free(y);
+        return NULL;
+    }
+    y->y = y->planes;
+    if (!OGPUR_IsPacked(format)) {
+        y->u = y->planes + (size_t)y->w * y->h;
+        y->v = (y->uvpitch == y->w) ? NULL : y->u + (size_t)(y->w / 2) * (y->h / 2);
