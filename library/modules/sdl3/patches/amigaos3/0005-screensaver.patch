+/* Open: while SDL holds the screen saver off (SDL_DisableScreenSaver, SDL's
+   default while a program runs), OpenBlanker is told every few seconds, as
+   X11's back end resets its screen saver. OpenBlanker 1.2 counts a CTRL_E to
+   its task as a key or the mouse; older ones ignore it. */
+#define OS3_BLANKER_PORT  "OpenBlanker"
+#define OS3_BLANKER_EVERY 5000      /* ms */
+static Uint64 os3_blanker_told;
+
+static void OS3_TellBlanker(void)
+{
+    struct MsgPort *port;
+
+    Forbid();
+    port = FindPort((CONST_STRPTR)OS3_BLANKER_PORT);
+    if (port && port->mp_SigTask) {
+        Signal((struct Task *)port->mp_SigTask, SIGBREAKF_CTRL_E);
+    }
+    Permit();
+    os3_blanker_told = SDL_GetTicks();
+    if (!os3_blanker_told) {
+        os3_blanker_told = 1;
+    }
+}
+
+bool OS3_SuspendScreenSaver(SDL_VideoDevice *_this)
+{
+    if (_this->suspend_screensaver) {
+        OS3_TellBlanker();
+    }
+    return true;
+}
+
