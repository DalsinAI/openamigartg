 {
     SDL_Window *sw;
 
+    if (_this->suspend_screensaver &&
+        (!os3_blanker_told || SDL_GetTicks() >= os3_blanker_told + OS3_BLANKER_EVERY)) {
+        OS3_TellBlanker();
+    }
+
