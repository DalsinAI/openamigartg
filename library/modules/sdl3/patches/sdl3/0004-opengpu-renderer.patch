+/* SDL_RenderGeometry on the CPU: SDL's software triangles. */
+static void OGPUR_CpuGeometry(SDL_Surface *surface, const SDL_RenderCommand *cmd, OGPUR_DrawStateCache *drawstate,
+                              const OGPUR_Vertex *v, int count)
+{
+    SDL_Texture *texture = cmd->data.draw.texture;
+    const SDL_BlendMode blend = cmd->data.draw.blend;
+    SDL_Point vp;
+    int i;
+
+    vp.x = drawstate->viewport ? drawstate->viewport->x : 0;
+    vp.y = drawstate->viewport ? drawstate->viewport->y : 0;
+    trianglepoint_2_fixedpoint(&vp);
+    if (texture) {
+        SDL_Surface *src = OGPUR_SURF(texture);
+        GeometryCopyData *ptr = (GeometryCopyData *)SDL_malloc(count * sizeof(GeometryCopyData));
+        if (!ptr) {
+            return;
+        }
+        for (i = 0; i < count; i++) {
+            ptr[i].src.x = (int)(v[i].u * texture->w);
+            ptr[i].src.y = (int)(v[i].v * texture->h);
+            ptr[i].dst.x = (int)v[i].x;
+            ptr[i].dst.y = (int)v[i].y;
+            trianglepoint_2_fixedpoint(&ptr[i].dst);
+            ptr[i].dst.x += vp.x;
+            ptr[i].dst.y += vp.y;
+            ptr[i].color = v[i].color;
+        }
+        PrepTextureForCopy(cmd, drawstate);
+        for (i = 0; i + 2 < count; i += 3) {
+            SDL_SW_BlitTriangle(
+                src,
+                &(ptr[i].src), &(ptr[i + 1].src), &(ptr[i + 2].src),
+                surface,
+                &(ptr[i].dst), &(ptr[i + 1].dst), &(ptr[i + 2].dst),
+                ptr[i].color, ptr[i + 1].color, ptr[i + 2].color,
+                cmd->data.draw.texture_address_mode_u,
+                cmd->data.draw.texture_address_mode_v);
+        }
+        SDL_free(ptr);
+    } else {
+        GeometryFillData *ptr = (GeometryFillData *)SDL_malloc(count * sizeof(GeometryFillData));
+        if (!ptr) {
+            return;
+        }
+        for (i = 0; i < count; i++) {
+            ptr[i].dst.x = (int)v[i].x;
+            ptr[i].dst.y = (int)v[i].y;
+            trianglepoint_2_fixedpoint(&ptr[i].dst);
+            ptr[i].dst.x += vp.x;
+            ptr[i].dst.y += vp.y;
+            ptr[i].color = v[i].color;
+        }
+        for (i = 0; i + 2 < count; i += 3) {
+            SDL_SW_FillTriangle(surface, &(ptr[i].dst), &(ptr[i + 1].dst), &(ptr[i + 2].dst), blend,
+                                ptr[i].color, ptr[i + 1].color, ptr[i + 2].color);
