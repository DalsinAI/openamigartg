diff --git a/src/dynapi/SDL_dynapi.c b/src/dynapi/SDL_dynapi.c
index 495a8e5..28d4adb 100644
--- a/src/dynapi/SDL_dynapi.c
+++ b/src/dynapi/SDL_dynapi.c
@@ -478,6 +478,16 @@ static SDL_INLINE void *get_sdlapi_entry(const char *fname, const char *sym)
     return result;
 }
 
+#elif defined(SDL_PLATFORM_AMIGAOS3)
+// Open (2026): SDL 3 lives inside one shared module, which hands its table
+// out through SDL_DYNAPI_entry; there is no other SDL to load over it.
+static SDL_INLINE void *get_sdlapi_entry(const char *fname, const char *sym)
+{
+    (void)fname;
+    (void)sym;
+    return NULL;
+}
+
 #else
 #error Please define your platform.
 #endif
@@ -514,6 +524,8 @@ static void SDL_InitDynamicAPILocked(void)
     char envbuf[512];  // overflows will just report as environment variable being unset, but LoadLibraryA has a MAX_PATH of 260 anyhow, apparently.
     const DWORD rc = GetEnvironmentVariableA(SDL_DYNAMIC_API_ENVVAR, envbuf, (DWORD) sizeof (envbuf));
     char *libname = ((rc != 0) && (rc < sizeof (envbuf))) ? envbuf : NULL;
+#elif defined(SDL_PLATFORM_AMIGAOS3)
+    char *libname = NULL;
 #else
     char *libname = getenv(SDL_DYNAMIC_API_ENVVAR); // This should NOT be SDL_getenv()
 #endif
diff --git a/src/dynapi/SDL_dynapi.h b/src/dynapi/SDL_dynapi.h
index 786d86e..b76cb50 100644
--- a/src/dynapi/SDL_dynapi.h
+++ b/src/dynapi/SDL_dynapi.h
@@ -65,6 +65,8 @@
 #define SDL_DYNAMIC_API 0 // devkitARM doesn't support dynamic linking
 #elif defined(SDL_PLATFORM_NGAGE)
 #define SDL_DYNAMIC_API 0
+#elif defined(SDL_PLATFORM_AMIGAOS3) && !defined(SDL_OPEN_LIBRARY_BUILD)
+#define SDL_DYNAMIC_API 0 // AmigaOS 3.x static link library: no dlopen()
 #elif defined(DYNAPI_NEEDS_DLOPEN) && !defined(HAVE_DLOPEN)
 #define SDL_DYNAMIC_API 0 // we need dlopen(), but don't have it....
 #endif
