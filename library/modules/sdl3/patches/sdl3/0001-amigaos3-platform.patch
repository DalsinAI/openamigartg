SDL 3.4.14 (Zlib): AmigaOS 3.x (68k) as a platform, for SDL3.module.
AmigaChrome Team, 2026. SDL_PLATFORM_AMIGAOS3, its build configuration
(include/SDL_build_config_amigaos3.h), its back ends in SDL's driver lists,
SDL3_68k's window property, the 68k's 16-bit alignment, and SDL's dynamic
API on inside the module (SDL_OPEN_LIBRARY_BUILD), where it hands its
table to the link stub.

diff --git a/include/SDL3/SDL_platform_defines.h b/include/SDL3/SDL_platform_defines.h
index 7963149..22ebf28 100644
--- a/include/SDL3/SDL_platform_defines.h
+++ b/include/SDL3/SDL_platform_defines.h
@@ -473,6 +473,14 @@
 #define SDL_PLATFORM_3DS 1
 #endif
 
+#if defined(__AMIGAOS3__) || (defined(__amiga__) && !defined(__amigaos4__) && !defined(__MORPHOS__))
+/**
+ * A preprocessor macro that is only defined if compiling for AmigaOS 3.x
+ * on the 68k (AmigaChrome Team, 2026).
+ */
+#define SDL_PLATFORM_AMIGAOS3 1
+#endif
+
 #ifdef __NGAGE__
 
 /**
diff --git a/include/SDL3/SDL_stdinc.h b/include/SDL3/SDL_stdinc.h
index b6403be..7d5bb45 100644
--- a/include/SDL3/SDL_stdinc.h
+++ b/include/SDL3/SDL_stdinc.h
@@ -1184,7 +1184,12 @@ typedef struct SDL_alignment_test
     Uint8 a;
     void *b;
 } SDL_alignment_test;
+#ifdef SDL_PLATFORM_AMIGAOS3
+/* The 68k aligns pointers on 2 bytes: { Uint8; void *; } is 6 bytes. */
+SDL_COMPILE_TIME_ASSERT(struct_alignment, sizeof(SDL_alignment_test) == 6);
+#else
 SDL_COMPILE_TIME_ASSERT(struct_alignment, sizeof(SDL_alignment_test) == (2 * sizeof(void *)));
+#endif
 SDL_COMPILE_TIME_ASSERT(two_s_complement, SDL_static_cast(int, ~SDL_static_cast(int, 0)) == SDL_static_cast(int, -1));
 #endif /* DOXYGEN_SHOULD_IGNORE_THIS */
 /** \endcond */
diff --git a/include/SDL3/SDL_video.h b/include/SDL3/SDL_video.h
index 2f06295..93828ad 100644
--- a/include/SDL3/SDL_video.h
+++ b/include/SDL3/SDL_video.h
@@ -1435,6 +1435,10 @@ extern SDL_DECLSPEC SDL_Window * SDLCALL SDL_CreateWindowWithProperties(SDL_Prop
 #define SDL_PROP_WINDOW_CREATE_WIDTH_NUMBER                        "SDL.window.create.width"
 #define SDL_PROP_WINDOW_CREATE_X_NUMBER                            "SDL.window.create.x"
 #define SDL_PROP_WINDOW_CREATE_Y_NUMBER                            "SDL.window.create.y"
+/** AmigaOS 3.x: a live struct Window * to borrow for an OpenGL SDL window,
+ * with SDL_PROP_WINDOW_CREATE_OPENGL_BOOLEAN. The application keeps the
+ * native window, its screen and its IDCMP events (SDL3_68k's property). */
+#define SDL_PROP_WINDOW_CREATE_AMIGAOS3_WINDOW_POINTER             "SDL.window.create.amigaos3.window"
 #define SDL_PROP_WINDOW_CREATE_COCOA_WINDOW_POINTER                "SDL.window.create.cocoa.window"
 #define SDL_PROP_WINDOW_CREATE_COCOA_VIEW_POINTER                  "SDL.window.create.cocoa.view"
 #define SDL_PROP_WINDOW_CREATE_WINDOWSCENE_POINTER                 "SDL.window.create.uikit.windowscene"
