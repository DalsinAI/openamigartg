+++ b/src/util/texcompress_astc_luts.h
@@ -22,7 +22,24 @@
 
 #pragma once
 
+#if defined(__amigaos__)
+/* AmigaOS: libstdc++ has no gthreads, so no std::mutex; the stove's pthreads. */
+#include <pthread.h>
+struct astc_mutex {
+   pthread_mutex_t m = PTHREAD_MUTEX_INITIALIZER;
+   void lock() { pthread_mutex_lock(&m); }
+   void unlock() { pthread_mutex_unlock(&m); }
+};
+struct astc_lock_guard {
+   astc_mutex &mu;
+   explicit astc_lock_guard(astc_mutex &m) : mu(m) { mu.lock(); }
+   ~astc_lock_guard() { mu.unlock(); }
+};
+#else
 #include <mutex>
+typedef std::mutex astc_mutex;
+typedef std::lock_guard<std::mutex> astc_lock_guard;
+#endif
 #include <unordered_map>
 #include <vector>
 
