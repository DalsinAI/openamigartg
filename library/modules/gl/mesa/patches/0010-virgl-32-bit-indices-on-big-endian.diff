diff --git a/src/gallium/drivers/virgl/virgl_context.c b/src/gallium/drivers/virgl/virgl_context.c
index f9bc79b..e4bbd5c 100644
--- a/src/gallium/drivers/virgl/virgl_context.c
+++ b/src/gallium/drivers/virgl/virgl_context.c
@@ -44,6 +44,7 @@
 #include "util/u_helpers.h"
 #include "util/slab.h"
 #include "util/u_upload_mgr.h"
+#include "util/u_endian.h"
 #include "util/u_blitter.h"
 
 #include "virgl_encode.h"
@@ -1037,6 +1038,41 @@ static void virgl_draw_vbo(struct pipe_context *ctx,
       util_primconvert_draw_vbo(vctx->primconvert, dinfo, drawid_offset, indirect, draws, num_draws);
       return;
    }
+#if UTIL_ARCH_BIG_ENDIAN
+   /* A big-endian CPU (the 68k on AmigaOS): a buffer's words reach the host
+    * turned round 32 bits at a time, which garbles 8 and 16-bit indices, so
+    * the host is given them as 32-bit ones. */
+   if (info.index_size && info.index_size < 4 && !indirect) {
+      const uint8_t *src;
+      struct pipe_transfer *xfer = NULL;
+      unsigned n = draws[0].count, isz = info.index_size, off = 0, i;
+      struct pipe_resource *buf = NULL;
+      uint32_t *dst = NULL;
+      if (info.has_user_indices)
+         src = (const uint8_t *)info.index.user + draws[0].start * isz;
+      else
+         src = pipe_buffer_map_range(ctx, info.index.resource, draws[0].start * isz, n * isz, PIPE_MAP_READ, &xfer);
+      if (src) {
+         u_upload_alloc_ref(vctx->uploader, 0, n * 4, 4, &off, &buf, (void **)&dst);
+         if (dst)
+            for (i = 0; i < n; i++)
+               dst[i] = isz == 2 ? ((const uint16_t *)src)[i] : src[i];
+         if (xfer)
+            pipe_buffer_unmap(ctx, xfer);
+      }
+      if (dst) {
+         u_upload_unmap(vctx->uploader);
+         ib.buffer = buf;
+         ib.user_buffer = NULL;
+         ib.index_size = 4;
+         ib.offset = off;
+         info.index_size = 4;
+         virgl_hw_set_index_buffer(vctx, &ib);
+         goto indices_set;
+      }
+      pipe_resource_reference(&buf, NULL);
+   }
+#endif
    if (info.index_size) {
            pipe_resource_reference(&ib.buffer, info.has_user_indices ? NULL : info.index.resource);
            ib.user_buffer = info.has_user_indices ? info.index.user : NULL;
@@ -1053,6 +1089,9 @@ static void virgl_draw_vbo(struct pipe_context *ctx,
            }
            virgl_hw_set_index_buffer(vctx, &ib);
    }
+#if UTIL_ARCH_BIG_ENDIAN
+indices_set:
+#endif
 
    if (!vctx->num_draws)
       virgl_reemit_draw_resources(vctx);
