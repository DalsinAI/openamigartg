+/* A vertex format the hardware reads right when it takes only 32-bit words:
+ * 32-bit channels, or everything packed into one 32-bit word. */
+static bool
+u_vbuf_format_is_32bit_words(enum pipe_format format)
+{
+   const struct util_format_description *d = util_format_description(format);
+   unsigned i;
+   if (!d || d->layout != UTIL_FORMAT_LAYOUT_PLAIN)
+      return false;
+   if (!d->is_array)
+      return d->block.bits == 32;
+   for (i = 0; i < d->nr_channels; i++)
+      if (d->channel[i].type != UTIL_FORMAT_TYPE_VOID && d->channel[i].size != 32)
+         return false;
+   return true;
+}
